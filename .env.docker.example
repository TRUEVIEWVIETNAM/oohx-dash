# ─────────────────────────────────────────────────────────────────────────────
# oohx-dash — Production env template cho Docker deploy
#
# Copy file này thành `.env` và fill các giá trị. APP_KEY là REQUIRED, app sẽ
# fail-fast nếu thiếu.
#   php artisan key:generate --show
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="OOHX"
APP_ENV=production
APP_KEY=                              # REQUIRED — base64:... — generate trước khi up
APP_DEBUG=false
APP_URL=https://oohx.net
APP_LOCALE=vi
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ── Multi-domain (Caddy đọc 2 var này để cấu hình 2 server blocks) ──────────
FRONTPAGE_DOMAIN=oohx.net             # Public marketing + buyer auth
DASH_DOMAIN=dash.oohx.net             # Filament admin/publisher/buyer panels
SESSION_DOMAIN=.oohx.net              # Cookie share giữa 2 subdomain
CADDY_ACME_EMAIL=admin@oohx.net       # Let's Encrypt account email

# ── Database (MySQL primary) ─────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=                              # Managed DB hostname (RDS/CloudSQL/...)
DB_PORT=3306
DB_DATABASE=oohx_dash
DB_USERNAME=
DB_PASSWORD=

# ── OOHX Data Engine (PostgreSQL — optional, qua SSH tunnel hoặc trực tiếp) ──
# Để trống nếu deploy không có Data Engine — code đã có silent-fail try/catch.
# Nếu deploy cùng host với DE: set host trỏ trực tiếp tới Postgres.
DB_OOHX_HOST=
DB_OOHX_PORT=5432
DB_OOHX_DATABASE=oohx_data
DB_OOHX_USERNAME=oohx_readonly
DB_OOHX_PASSWORD=
DB_OOHX_CONTROL_USERNAME=oohx_control
DB_OOHX_CONTROL_PASSWORD=

# ── Cache / Session / Queue ──────────────────────────────────────────────────
# Mặc định database driver — không cần Redis. Đổi sang redis nếu muốn dùng dev profile.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# ── Redis (chỉ dùng khi CACHE_STORE=redis hoặc QUEUE_CONNECTION=redis) ──────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Filesystem ───────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail (production: SMTP qua provider như SES/Resend/Postmark) ────────────
MAIL_MAILER=smtp
MAIL_HOST=                            # smtp.resend.com / email-smtp.us-east-1.amazonaws.com / ...
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@oohx.net"
MAIL_FROM_NAME="${APP_NAME}"

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stderr                    # Container logs → docker logs
LOG_STACK=stderr
LOG_LEVEL=info

# ── Image build options (dùng bởi docker-compose build) ──────────────────────
APP_TAG=latest

# ── Nền bản đồ ───────────────────────────────────────────────────────────────
#
# Khóa MapTiler. Để trống thì mười hai bản đồ dùng Esri — không cần khóa, chạy
# được, chỉ là một nguồn dùng theo lệ chứ không có hạn mức cam kết.
#
# Hai điều phải biết trước khi đặt khóa vào đây:
#
#  1. Khóa này **hiện ra trong trình duyệt của mọi khách**, vì chính trình
#     duyệt gọi URL tile. Mọi khóa tile client-side đều vậy. Thứ bảo vệ hạn
#     mức không phải sự bí mật mà là **giới hạn origin** đặt trong MapTiler
#     Cloud: chỉ cho phép `oohx.net` và `dash.oohx.net`. Không bật giới hạn
#     đó thì bất kỳ ai chép khóa cũng tiêu hạn mức của sàn.
#  2. `deploy.sh` đọc khóa từ ĐÂY rồi truyền sang Next lúc build. Không chép
#     nó sang `webapp/` — hai bản sao là hai thứ sẽ lệch nhau.
#
# Raster tile mặc định của MapTiler có nhãn **tiếng Anh** ("West Lake",
# "Red River"). Muốn tiếng Việt thì tạo một style riêng trong MapTiler Cloud,
# đặt ngôn ngữ nhãn là Vietnamese, rồi để tên style vào `MAPTILER_STYLE`.
MAPTILER_KEY=
# MAPTILER_STYLE=streets-v2

# ── Dev-only (bỏ qua trong prod) ─────────────────────────────────────────────
# DB_ROOT_PASSWORD=root
# DB_PORT_HOST=3306
# MAILPIT_UI_PORT=8025
