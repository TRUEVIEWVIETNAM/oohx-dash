# Biến môi trường cho BỘ TEST. Không chứa secret nào — repo này là public.
#
# ══ Vì sao file này tồn tại ══
#
# 1. Dọn cảnh báo che mọi cảnh báo khác.
#
#    610/619 test từng ở trạng thái WARN với cùng một thông điệp:
#    `file_get_contents(<repo>/.env): Failed to open stream`. CI cố ý KHÔNG có
#    `.env` (có chốt `test ! -f .env || exit 1`, vì `.env` của dự án trỏ vào
#    CSDL production), và Laravel dựng lại app ở mỗi test nên nó đọc `.env`
#    mỗi lần.
#
#    `phpdotenv` đã bọc `@file_get_contents()`, nhưng dấu `@` chỉ chặn PHP tự
#    in — PHPUnit cài error handler riêng và vẫn ghi nhận. Nên cảnh báo xuất
#    hiện ở mọi test.
#
#    Với `APP_ENV=testing`, Laravel tìm `.env.testing` TRƯỚC và nếu có thì
#    không bao giờ đọc `.env` nữa (`LoadEnvironmentVariables::
#    checkForSpecificEnvironmentFile`). Nên có file này là cảnh báo biến mất,
#    mà chốt an toàn "không có .env trong CI" vẫn còn nguyên.
#
#    Một bộ test mà 98% là WARN thì cảnh báo mới nào cũng chìm. Chìm thì nó
#    không còn là cảnh báo.
#
# 2. Làm việc chạy test cục bộ an toàn theo mặc định.
#
#    `CLAUDE.md` mục 7: "`.env` đang trỏ vào CSDL production. Không bao giờ
#    chạy test mà chưa ghi đè toàn bộ biến CSDL." Đó là một quy tắc dựa vào
#    việc người chạy nhớ ghi đè. File này biến nó thành mặc định: `DB_HOST`
#    dưới đây là `127.0.0.1`, nên một lần quên ghi đè sẽ hỏng vì không kết nối
#    được, chứ không phải vì vừa xóa dữ liệu thật.
#
# ══ Thứ tự ưu tiên ══
#
# Biến môi trường THẬT thắng giá trị trong file này: `Illuminate\Support\Env`
# dựng repository bằng `->immutable()`. Nên CI vẫn dùng đúng giá trị nó truyền
# qua `env:` của workflow, và file này chỉ là lưới đỡ cho người chạy cục bộ.

APP_NAME=OOHX
APP_ENV=testing
# Khóa dùng một lần, cố ý nhìn là biết không phải khóa thật.
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://oohx.test

FRONTPAGE_DOMAIN=oohx.test
DASH_DOMAIN=dash.oohx.test

# Chạy test trên MySQL, KHÔNG dùng SQLite: migration của dự án dùng cú pháp
# riêng của MySQL (SHOW INDEX, UPDATE ... JOIN, ALTER TABLE ... PARTITION BY).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oohx_test
DB_USERNAME=root
DB_PASSWORD=test
# Để rỗng tường minh: một DB_URL sót lại sẽ ghi đè mọi biến DB_* ở trên.
DB_URL=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

BCRYPT_ROUNDS=4
LOG_CHANNEL=stack
LOG_LEVEL=debug
